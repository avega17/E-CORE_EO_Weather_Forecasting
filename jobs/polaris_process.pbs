#!/bin/bash -l
#PBS -N ecore_process
#PBS -l select=1:system=polaris
#PBS -l walltime=06:00:00
#PBS -l filesystems=home:eagle
#PBS -q capacity
#PBS -j oe
set -euo pipefail
echo "E-CORE processing wrapper entered | job ${PBS_JOBID:-local} | host $(hostname)"
phase=startup
trap 'status=$?; echo "E-CORE processing ended | phase $phase | exit $status"' EXIT
: "${ECORE_PROJECT_ROOT:?Source jobs/polaris.env.sh before submission}"
task="${ECORE_PROCESS_TASK:-materialize}"
case "$task" in setup|setup-benchmark|benchmark|materialize) ;; *) echo 'Use setup, setup-benchmark, benchmark or materialize for ECORE_PROCESS_TASK' >&2; exit 2;; esac
code="${ECORE_CODE_ROOT:-$ECORE_PROJECT_ROOT/ecore-weather/repo}"
python="${ECORE_PROCESS_PYTHON:-$ECORE_PROJECT_ROOT/ecore-weather/envs/processing-3km/bin/python}"
start="${ECORE_PROCESS_START:-2022-09-18}"
end="${ECORE_PROCESS_END:-2022-09-19}"
scratch="${ECORE_NODE_SCRATCH:-/local/scratch}/ecore-process-${USER}-${PBS_JOBID%%.*}"
state="${ECORE_PROCESS_STATE:-$ECORE_PROJECT_ROOT/ecore-weather/state/processing}"
archives="${ECORE_DATASET_ROOT:-$ECORE_PROJECT_ROOT/ecore_eo_datasets}"
mkdir -p "$scratch" "$state"
export TMPDIR="$scratch/tmp"
mkdir -p "$TMPDIR"
export OMP_NUM_THREADS=1 OPENBLAS_NUM_THREADS=1 MKL_NUM_THREADS=1 NUMEXPR_NUM_THREADS=1
cd "$code"
if [[ "$task" == setup || "$task" == setup-benchmark ]]; then
  phase=processing-environment
  module use /soft/modulefiles
  module load conda/2026-10-01
  export HTTP_PROXY=http://proxy.alcf.anl.gov:3128 HTTPS_PROXY=http://proxy.alcf.anl.gov:3128
  export http_proxy="$HTTP_PROXY" https_proxy="$HTTPS_PROXY"
  export CONDA_PKGS_DIRS="$ECORE_PROJECT_ROOT/ecore-weather/conda-cache"
  export MAMBA_EXTRACT_THREADS=4 CONDA_DEFAULT_THREADS=4 CONDA_EXECUTE_THREADS=2 CONDA_VERIFY_THREADS=2
  prefix="${python%/bin/python}"
  if [[ "$prefix" == "$python" ]]; then
    echo 'ECORE_PROCESS_PYTHON must end in /bin/python' >&2
    exit 2
  fi
  if [[ ! -x "$python" ]]; then
    conda create --yes --prefix "$prefix" --file "$code/jobs/environment-polaris-linux-64.lock"
  fi
  "$python" -m pip install obstore==0.11.1 earth2studio==0.18.0 scipy==1.18.1 pyresample==1.35.0 satpy==0.59.0 virtualizarr==2.7.3
  "$python" -m pip check
  "$python" - <<'PY_CHECK'
import tempfile
import numpy as np
import scipy, pyresample, satpy, pyarrow, zarr
with tempfile.TemporaryDirectory() as directory:
    values = np.arange(4)
    zarr.save_array(directory, values, zarr_format=3)
    np.testing.assert_array_equal(zarr.open_array(directory, mode="r")[:], values)
print("CPU processing imports and Zarr round trip passed")
PY_CHECK
  if [[ "$task" == setup ]]; then exit 0; fi
  task=benchmark
fi
phase=walltime
walltime="$(qstat -f "$PBS_JOBID" | sed -n 's/^[[:space:]]*Resource_List.walltime = //p')"
hours="$($python -c 'import sys; h,m,s=map(int,sys.argv[1].split(":")); total=h*3600+m*60+s; print(max(1,total-900)/3600)' "$walltime")"
if [[ "$task" == benchmark ]]; then
  phase=processing-index
  mpiexec -n 1 --ppn 1 --depth 64 "$python" scripts/dataset_jobs.py process index \
    --location "$archives" --preparation-root "$scratch/preparation" \
    --index-path "$scratch/process.duckdb" --output "$state" \
    --start "$start" --end "$end" --resolution-km "${ECORE_PROCESS_RESOLUTION:-3}"
  selection="$($python -c 'import json,sys; print(json.load(open(sys.argv[1]))["result"]["preparation_path"])' "$state/latest.json")"
  cp "$selection/selection.json" "$state/benchmark-selection.json"
  read -r -a worker_counts <<< "${ECORE_PROCESS_WORKER_COUNTS:-8 16 32 64}"
  phase=processing-benchmark
  mpiexec -n 1 --ppn 1 --depth 64 "$python" scripts/dataset_jobs.py process benchmark \
    --selection "$selection" --worker-counts "${worker_counts[@]}" \
    --repeats "${ECORE_PROCESS_REPEATS:-3}" --destination "$scratch/benchmark" --output "$state"
  cp "$scratch/process.duckdb" "$state/closed-index.duckdb"
  exit 0
fi
phase=materialization
set +e
mpiexec -n 1 --ppn 1 --depth 64 "$python" scripts/dataset_jobs.py process materialize \
  --location "$archives" --preparation-root "$archives/preparation" \
  --destination "$scratch/processed" --index-path "$scratch/process.duckdb" \
  --output "$state" --start "$start" --end "$end" \
  --resolution-km "${ECORE_PROCESS_RESOLUTION:-1}" --mode "${ECORE_PROCESS_MODE:-auto}" \
  --compression "${ECORE_PROCESS_COMPRESSION:-zstd}" --reserve-percent 5 \
  --chunk-time "${ECORE_PROCESS_CHUNK_TIME:-1}" --shard-time "${ECORE_PROCESS_SHARD_TIME:-0}" \
  --correction "${ECORE_PROCESS_CORRECTION:-none}" \
  --memory-mib "${ECORE_PROCESS_MEMORY_MIB:-65536}" --workers "${ECORE_PROCESS_WORKERS:-0}" \
  --executor "${ECORE_PROCESS_EXECUTOR:-process}" --prefetch-batches "${ECORE_PROCESS_PREFETCH_BATCHES:-4}" \
  --max-hours "$hours"
status=$?
set -e
if [[ -f "$scratch/process.duckdb" ]]; then cp "$scratch/process.duckdb" "$state/closed-index.duckdb"; fi
if [[ "$status" == 75 ]]; then echo 'Processing intentionally paused with verified node-local checkpoints'; fi
echo "Processed arrays stay on node scratch: $scratch/processed"
echo 'Consume them within this allocation; future jobs rebuild disposable variants from Eagle preparation.'
exit "$status"
